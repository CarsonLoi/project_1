# Disable webpack source-map-loader for node_modules.
#
# A transitive dependency (@mediapipe/tasks-vision, pulled in by
# @react-three/drei) ships .mjs files that point at a .map file it does
# not include, so source-map-loader logs:
#   "Failed to parse source map ... vision_bundle_mjs.js.map (ENOENT)"
#
# In react-scripts 5, the source-map-loader pre-rule is gated on
# GENERATE_SOURCEMAP, so setting this to false removes the loader and the
# warning. Your own app code still gets dev source maps via webpack's
# devtool ('cheap-module-source-map'); only the production build skips
# emitting .map files.
GENERATE_SOURCEMAP=false
