# Copy this file to `.env.local` (gitignored) and fill in values for local
# development. CRA reads `REACT_APP_*` vars at build/start time.

# Override the WD 24-hr backend endpoint. If unset, the dashboard uses the
# default baked into src/utils/performance/wdDataSource.js. If the endpoint
# is unreachable, the dashboard automatically falls back to the bundled
# src/data/data_wd_cod.json so the demo never goes blank.
REACT_APP_WD_API_URL=http://10.100.122.41:9000/cod_sthourlydata

# Override the Trend Seeker walker-hand endpoint. The dashboard appends
# `?date=YYYY-MM-DD` based on the date picker. If unreachable, falls back
# to synthetic generateTimeSeries() data so the demo never goes blank.
REACT_APP_TREND_API_URL=http://10.100.122.41:9000/cod_walker_hands

# Override the table open/close-status endpoint (fetched in parallel with
# the walker hands). The dashboard appends `?date=YYYY-MM-DD`. Response is
# an array of { datetime, table, is_open } rows. If unreachable, tables
# without a status record are treated as open.
REACT_APP_TABLE_STATUS_API_URL=http://10.100.122.41:9000/cod_table_status
